{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build NGEP Project",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "main.cpp",
                "product.cpp",
                "-o",
                "main.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Compiles main.cpp + product.cpp together"
        },
        {
            "label": "Build & Run NGEP Project",
            "type": "shell",
            "command": "g++ -std=c++17 main.cpp product.cpp -o main.exe && .\\main.exe",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Compiles and immediately runs the program"
        }
    ]
}
